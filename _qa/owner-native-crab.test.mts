test('owner native pins, hidden safety, lateral persisted movement, semantic cache and zero-time motion reconciliation',()=>{
 for(const [scene,townMinutes] of [['coast',540],['beach',780],['dock',1140],['coast',1380]] as const){const s:Save={...initial('en',randomUUID()),scene,townMinutes,position:{x:900,y:700},flags:['key','unpacked']};advanceNativeCrab(s,0,true);assert.ok(s.nativeCrabV1?.frame.visible);const before=structuredClone(s.nativeCrabV1),key=lifeProjectionKey(s);advanceNativeCrab(s,1.2,true);const n=s.nativeCrabV1!;assert.equal(n.frame.foot[n.frame.direction==='down'||n.frame.direction==='up'?'y':'x'],before.frame.foot[n.frame.direction==='down'||n.frame.direction==='up'?'y':'x']);assert.ok(n.frame.distance>0);assert.equal(lifeProjectionKey(s),key);assert.deepEqual(nativeCrabFrame(s,s.position).frame,n.frame);assert.ok(validNativeCrabField(n,s.version,townMinutes));assert.equal(validNativeCrabField({...n,pin:{...nativeCrabPin,revision:1}},s.version,townMinutes),false);assert.equal(validNativeCrabField({...n,page:{sourceAction:randomUUID(),minute:townMinutes}},s.version,townMinutes),false);const prior={...s,nativeCrabV1:undefined};assert.ok(!nativeCrabFrame(prior,n.frame.foot).frame.visible||Math.hypot(nativeCrabFrame(prior,n.frame.foot).frame.foot.x-n.frame.foot.x,nativeCrabFrame(prior,n.frame.foot).frame.foot.y-n.frame.foot.y)>0);}
});

test('native foreground supports both existing clock rates, excludes opening/offline time and rejects client-selected budget',()=>{
 for(const rate of [2000,4000] as const){let at=100000;const a=createExplorationAssembly({now:()=>at,defaultRate:rate,crabEnabled:true});const s:any={...initial('en',randomUUID()),scene:'coast',position:{x:1032,y:462},flags:['key','unpacked']};const opened=a.play.apply(s,{action_id:randomUUID(),expected_version:0,scene:s.scene,position:s.position,target:'',action:'candidate-active-open',payload:{client:randomUUID()}});assert.equal(opened.townMinutes,540);assert.ok(opened.nativeCrabV1);const lease=opened.activePlayClock.lease;at+=1500;const tick=a.play.apply(opened,{action_id:randomUUID(),expected_version:0,scene:s.scene,position:s.position,target:'',action:'candidate-active-tick',payload:{client:lease.client,lease:lease.id,sequence:1,activeMs:1500}});assert.ok(tick.nativeCrabV1.frame.distance>0);assert.equal(tick.activePlayClock.remainderMs,1500);at+=86400000;const re=a.play.apply(tick,{action_id:randomUUID(),expected_version:0,scene:s.scene,position:s.position,target:'',action:'candidate-active-open',payload:{client:lease.client}});assert.deepEqual(re.nativeCrabV1.frame,tick.nativeCrabV1.frame);assert.equal(re.townMinutes,tick.townMinutes)}
});
