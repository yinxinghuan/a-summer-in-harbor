for(const backend of process.env.HARBOR_ACCOUNT_QA_PG_URL?['pg']:['sqlite'])test(`native crab ${backend}/normal account HTTP: real authority checkpoint/proof, bounded head, atomic observation/share, rollback and restart`,async()=>{
