  const motion=async(kind='candidate-motion-open',points?:any[])=>{now+=500;const last=s.movingClock?.transport?.last.ack,l=s.movingClock?.lease,ordinal=(last?.ordinal??0)+1,a={action_id:motionActionId(s.id,ordinal),expected_version:s.version,scene:s.scene,position:points?.at(-1)??s.position,target:'',action:kind,payload:{transport:1,ordinal,previous:last?.token??'',...(kind.endsWith('step')?{lease:l.id,sequence:l.sequence+1,points:points??[]}: {})}},before=s,r=await req('/sessions/'+s.id+'/motion',a);assert.equal(r.status,200,JSON.stringify(r));const patched=applyMotionAck(before,r.body);await get();assert.deepEqual(patched.nativeCrabV1,s.nativeCrabV1);return {a,r}};
  const play=async(kind:string,ms=0)=>{now+=ms;const last=s.activePlayClock?.transport?.last.ack,l=s.activePlayClock?.lease,ordinal=(last?.ordinal??0)+1,a={action_id:activePlayActionId(s.id,ordinal),expected_version:s.version,scene:s.scene,position:s.position,target:'',action:kind,payload:{client,ordinal,previous:last?.token??'',...(kind.endsWith('open')?{}:{lease:l.id,sequence:l.sequence+1,activeMs:ms})}},r=await req('/sessions/'+s.id+'/active-play',a);assert.equal(r.status,200,JSON.stringify(r));await get();return {a,r}};
  await create();const original=structuredClone(s);for(let i=0;i<3;i++){const v=(await req('/sessions/'+s.id+'/life')).body;assert.equal(v.plantUses.basilEnabled,true);assert.equal(v.plantUses.mintEnabled,false);assert.equal(v.animals.schema,1);assert.equal(v.collections.length,0);assert.deepEqual(await get(),original)}cases.push('old GETs pure; basil/B2/old seven animals retained');
  await commit(action('', '',{millisecondsPerMinute:4000},{action:'candidate-clock-enable'}));await motion();assert.ok(s.nativeCrabV1?.frame.visible);assert.equal(s.nativeCrabV1.frame.pose,'stand');
  const frozenCollider=structuredClone(s),lastMotion=s.movingClock.transport.last.ack,ordinal=lastMotion.ordinal+1,colliderGoal={...s.nativeCrabV1.frame.foot};now+=1250;const crossed=await req('/sessions/'+s.id+'/motion',{action_id:motionActionId(s.id,ordinal),expected_version:s.version,scene:s.scene,position:colliderGoal,target:'',action:'candidate-motion-step',payload:{transport:1,ordinal,previous:lastMotion.token,lease:s.movingClock.lease.id,sequence:s.movingClock.lease.sequence+1,points:[colliderGoal]}});assert.deepEqual(crossed,{status:400,body:{error:'INVALID_MOTION_PATH',terminal:true}});assert.deepEqual(await get(),frozenCollider);cases.push('authoritative native ground body blocks a swept movement; no head/time mutation');
  const p=s.position,beforeInvalid=structuredClone(s);for(const a of [action('sample',nativeCrabId,{command:{verb:'sample',frame:{foot:{x:0,y:0}}}}),action('sample',nativeCrabId,undefined,{position:{x:p.x+3,y:p.y}})]){const r=await req('/sessions/'+s.id+'/action',a);assert.equal(r.status,409,JSON.stringify(r));assert.equal(r.body.terminal,true);assert.deepEqual(await get(),beforeInvalid)}cases.push('client pose rejected; position must equal a confirmed checkpoint');
  const sample=action('sample'),observed=await commit(sample);assert.equal(s.nativeCrabV1.sample.quietMs,400);assert.equal(s.nativeCrabV1.sample.version,s.version);assert.equal(waits,1);assert.deepEqual(await req('/sessions/'+s.id+'/action',sample),observed);assert.equal(waits,1);assert.deepEqual(s.items,original.items);assert.equal(s.cash,original.cash);const key=lifeProjectionKey(s);await motion('candidate-motion-step');assert.equal(currentNativeSample(s),undefined);assert.notEqual(lifeProjectionKey(s),key);const stale=await req('/sessions/'+s.id+'/action',action('record'));assert.deepEqual(stale,{status:409,body:{error:'OBSERVATION_STALE',terminal:true}});cases.push('400ms guarded observation; exact replay; a motion version invalidates proof');
  await commit(action('sample'));const proof=structuredClone(s),record=action('record'),runtime=factory().runtime,direct=new AsyncSessionAuthority(server.store,runtime);await direct.prepareAction(owner,s.id,record);assert.deepEqual(await get(),proof);
  const faulty={...server.store,transaction:(work:any)=>server.store.transaction((repo:any)=>work({...repo,addReceipt:async()=>{throw Error('INJECTED_RECEIPT_FAILURE')}}))};await assert.rejects(new AsyncSessionAuthority(faulty,runtime).commitPreparedAction(owner,s.id,record),/INJECTED_RECEIPT_FAILURE/);assert.deepEqual(await get(),proof);const recorded=await direct.commitPreparedAction(owner,s.id,record);s=recorded.head;assert.deepEqual(await req('/sessions/'+s.id+'/action',record),{status:200,body:recorded});assert.ok(s.nativeCrabV1.observation);assert.equal(s.nativeCrabV1.sample,undefined);assert.equal((await req('/sessions/'+s.id+'/life')).body.collections.length,1);cases.push('receipt failure rolls back observation; same prepared ID completes once');
  const firstRecord=s.nativeCrabV1.observation;await play('candidate-active-open');await play('candidate-active-tick',1000);assert.equal(s.nativeCrabV1.frame.phase,'sidewalk');const movingHead=structuredClone(s);assert.deepEqual(await req('/sessions/'+s.id+'/action',action('sample')),{status:409,body:{error:'CRAB_NEEDS_QUIET_MOMENT',terminal:true}});assert.deepEqual(await get(),movingHead);cases.push('moving crab cannot mint a quiet proof, and a failed action preserves foreground lease');let maxHeadBytes=0,maxAckBytes=0;const sizeBefore=JSON.stringify(s).length;for(let i=0;i<120;i++){const r=await play('candidate-active-tick',500);maxHeadBytes=Math.max(maxHeadBytes,JSON.stringify(s).length);maxAckBytes=Math.max(maxAckBytes,JSON.stringify(r.r.body).length)}assert.ok(maxAckBytes<5000);assert.ok(maxHeadBytes-sizeBefore<5000);assert.deepEqual(s.nativeCrabV1.observation,firstRecord);await play('candidate-active-pause');cases.push('120 active compact ACKs: bounded latest confirmation, no append-only crab ledger');
  const travel=action('', 'dock',undefined,{action:'travel-map',payload:undefined});await commit(travel);await motion();const goal=entityAt('dock','ruth')!.approach,w=landWorld(dynamicWorld(s.flags,false),s.landV1),path=findPath(w,'dock',s.position,goal);assert.ok(path.length);for(let i=0;i<path.length;i++)await motion('candidate-motion-step',[path[i]]);assert.ok(Math.hypot(s.position.x-goal.x,s.position.y-goal.y)<1);
  const ref={command:{verb:'brief',ref:crabCommissionRef}};await commit(action('brief','ruth',ref));await commit(action('accept','ruth',{command:{verb:'accept',ref:crabCommissionRef}}));const share=action('share','ruth',{command:{verb:'share',ref:crabCommissionRef}}),twin={...share,action_id:randomUUID()},results=await Promise.all([req('/sessions/'+s.id+'/action',share),req('/sessions/'+s.id+'/action',twin)]);assert.equal(results.filter(r=>r.status===200).length,1,JSON.stringify(results));await get();assert.equal(s.relations.ruth,1);assert.deepEqual(s.items,original.items);assert.equal(s.cash,original.cash);assert.equal((await req('/sessions/'+s.id+'/life')).body.animals.pages.filter((p:any)=>p.ref.id===crabCommissionRef.id).length,1);cases.push('normal travel and authoritative path to Ruth; competing shares grant one relationship point and one page');
  const other=await bootstrap();assert.notEqual((await req('/sessions/'+s.id,undefined,other)).status,200);assert.notEqual((await req('/sessions/'+s.id+'/life',undefined,other)).status,200);cases.push('second normal account cookie cannot read another journey');
