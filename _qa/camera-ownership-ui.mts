const root=resolve('..'),dist=resolve('dist'),moduleRoot=resolve('.');
const {makeDemoServer}=await import(moduleRoot+'/_qa/temporary-account-server.ts');
const {createExplorationAssembly}=await import(moduleRoot+'/server/exploration-assembly.ts'),{withWildMint}=await import(moduleRoot+'/server/wild-mint.ts'),{withBasilPlantUses}=await import(moduleRoot+'/server/plant-basil.ts');
