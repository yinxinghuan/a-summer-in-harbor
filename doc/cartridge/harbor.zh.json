  "opening": {
    "location": "车站街",
    "time": "夏初 · 午后",
    "objective": "和提着钥匙的女士打个招呼。",
    "imagePrompt": "A newcomer arrives on a modest North American coastal street in summer.",
    "blocks": [
      {
        "id": "arrival-0",
        "kind": "narration",
        "text": "你刚下长途汽车，肩上只有一只旅行包。上一份工作告一段落，你给自己留了一个夏天，来到这个从没住过的海湾小镇。没有紧急任务，也没有人等着你拯救什么。先安顿下来，认识几个人，看看自己想把日子过成什么样。"
      },
      {
        "id": "arrival-1",
        "kind": "narration",
        "text": "你提前租了一间小屋。约好的房东正在街边等你，手里晃着一串钥匙。用左下角的摇杆走过去，也可以点地面行走。靠近她以后，右下角会出现谈话按钮。"
      }
    ],
    "choices": [
      {
        "id": "meet-mara",
        "label": "走过去打个招呼"
      }
    ]
  },
  "characters": [
    {
      "id": "mara",
      "name": "玛拉",
      "role": "提着钥匙的女士",
      "detail": "一位穿亚麻衬衣的女士抬手招呼。她晃了晃钥匙：“你就是来住一夏的新房客吧？我是玛拉。先放下行李，别急着认全镇的人。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "theo",
      "name": "西奥",
      "role": "擦杯子的店员",
      "detail": "柜台后的年轻人把杯子放下，围裙上写着Theo。“叫我西奥。你刚到？玛拉把她的工具袋忘在这里了。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "june",
      "name": "琼",
      "role": "工作台旁的女人",
      "detail": "穿工装的女人从工作台旁抬起头：“我是琼，这间修理铺是我的。全年都有人弄坏东西。需要借工具？”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "idris",
      "name": "伊德里斯",
      "role": "整理手套的教练",
      "detail": "一个肩膀宽厚的中年男人正在晾手套。“我是伊德里斯。想练练脚步？先学躲，出拳不着急。这里谁都可以说停。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "ruth",
      "name": "露丝",
      "role": "码头边的钓鱼人",
      "detail": "戴旧帆布帽的女人把备用鱼竿靠在栏杆上。“露丝。别踩桶，那是我的午饭。你想试一竿吗？”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "luis",
      "name": "路易斯",
      "role": "补货的店主",
      "detail": "店主从一箱苹果后探出头：“路易斯。新面孔！水龙头在门边，免费。别在第一天就把钱全花在我这里。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "nell",
      "name": "内尔",
      "role": "整理旧照片的店主",
      "detail": "灰发店主把一张褪色照片压平。“我是内尔。有些东西人们搬走时不愿带走，却又舍不得丢。你看这座桥。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "elena",
      "name": "埃琳娜",
      "role": "浇花的住户",
      "detail": "拿着水壶的女人停在小门内。“埃琳娜。我知道大家想穿过这里去海边，但这里也是我妈妈午睡的地方。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "arthur",
      "name": "阿瑟",
      "role": "擦拭风向仪的老人",
      "detail": "老人取下帽子，指了指胸前磨旧的名牌：Arthur。“以前每天都要量风。现在大家只看手机，不过手机可不知道下面那条小路。”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    }
  ],
