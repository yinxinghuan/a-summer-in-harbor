  "opening": {
    "location": "Station Street",
    "time": "Early summer · Afternoon",
    "objective": "Say hello to the woman with the keys.",
    "imagePrompt": "A newcomer arrives on a modest North American coastal street in summer.",
    "blocks": [
      {
        "id": "arrival-0",
        "kind": "narration",
        "text": "The bus pulls away. You lift your bag and catch the salt in the breeze. Your last job has ended. You have given yourself one summer in a town where nobody knows you yet."
      },
      {
        "id": "arrival-1",
        "kind": "narration",
        "text": "You arranged a room before leaving. Your landlady promised to meet you with the key. Today, finding your room is enough. A woman beside the street raises a set of keys. She seems to be waiting for you."
      },
      {
        "id": "arrival-2",
        "kind": "narration",
        "text": "Use the round stick at the bottom left, or tap the ground to walk. Move close to the woman with the keys, then tap Interact at the bottom right. Start with hello."
      }
    ],
    "choices": [
      {
        "id": "meet-mara",
        "label": "Go and say hello"
      }
    ]
  },
  "characters": [
    {
      "id": "mara",
      "name": "Mara",
      "role": "Woman with the keys",
      "detail": "A woman in a linen shirt waves a key. “You must be my summer tenant. I’m Mara. Let’s put your bag down before you try to learn the whole town.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "theo",
      "name": "Theo",
      "role": "Man drying a cup",
      "detail": "The man behind the counter sets down a cup. His apron reads Theo. “Just arrived? Mara left her tool bag here. You’re welcome to sit a while.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "june",
      "name": "June",
      "role": "Woman at the workbench",
      "detail": "The woman at the workbench looks up. “June. Like the sign. Things break all year, though. Need to borrow something?”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "idris",
      "name": "Idris",
      "role": "Coach sorting gloves",
      "detail": "A broad-shouldered man hangs up a pair of gloves. “Idris. Want to try the footwork? Learn to move first. Anyone here can call a stop.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "ruth",
      "name": "Ruth",
      "role": "Angler at the pier",
      "detail": "A woman in a faded canvas hat sets a spare rod against the rail. “Ruth. Mind the bucket—that’s lunch. Fancy a try?”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "luis",
      "name": "Luis",
      "role": "Shopkeeper restocking",
      "detail": "The shopkeeper peeks over a crate of apples. “Luis. New face! Free tap water by the door. Don’t spend your whole first day’s money here.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "nell",
      "name": "Nell",
      "role": "Shopkeeper sorting photographs",
      "detail": "The grey-haired shopkeeper flattens a faded photograph. “Nell. Some things are too heavy to take and too dear to throw away. Look at this bridge.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "elena",
      "name": "Elena",
      "role": "Resident watering flowers",
      "detail": "A woman with a watering can stops inside the gate. “Elena. I know everyone wants a way to the sea. It’s also where my mother takes her afternoon nap.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    },
    {
      "id": "arthur",
      "name": "Arthur",
      "role": "Man cleaning a weather vane",
      "detail": "The older man removes his cap and taps a worn name badge: Arthur. “Used to measure the wind every day. Phones do it now. They don’t know the little path below us, though.”",
      "vitality": 100,
      "stress": 0,
      "skills": [],
      "hiddenUntilIntroduced": true
    }
  ],
